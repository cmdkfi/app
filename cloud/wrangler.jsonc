{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // cmdk relayer and rebalancer timer on Cloudflare Containers (testnet only: Base Sepolia, NEAR testnet).
  // cloud/README.md has the commands. Secrets (wrangler secret put, never in this file): BASE_EOA_KEY_JSON,
  // NEAR_RELAYER_KEY_JSON, NEAR_RELAYER_ACCOUNT, ADMIN_TOKEN.
  "name": "cmdk-relayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [{ "pattern": "relayer.cmdk.fi", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // the app origins allowed by CORS (comma separated)
    "ALLOWED_ORIGINS": "https://cmdk.fi,http://localhost:5173",
    // relayer.py serve --factory: vault/factory/DEPLOY.md's factory.$ACCOUNT. The account is created on Friday
    // (DEPLOY.md 7a, recorded in 7c); until it exists the relayer runs, /health says "factory_exists": false and
    // /create-vault answers 503 (cloud/front.py)
    "NEAR_FACTORY_ACCOUNT": "factory.prime-measure-1792736012.testnet",
    // POST /create-vault is open to browsers with these limits (429 with Retry-After beyond; founder, 3 Nov):
    // per client IP (CF-Connecting-IP) per rolling hour, and in all per rolling 24 hours
    "CREATE_PER_IP_PER_HOUR": "2",
    "CREATE_PER_DAY": "20",
    // the timer's arguments to rebalance_pool.py, as DEPLOY.md step 6 gave rebalance.sh
    "REBALANCE_ARGS": "--band-usdc 10",
    "BASE_RPC": "https://base-sepolia-rpc.publicnode.com",
    "NEAR_RPC": "https://rpc.testnet.near.org",
    // the agent's evidence endpoint (agent/src/serve.rs, port 8080), no trailing slash: the Phala gateway URL of the
    // CVM's port 8080 (agent/MEASUREMENT.md §4). Empty until the Friday launch (DEPLOY.md step 8 sets it and
    // redeploys). Empty: GET /agent/... answers 503 and the cron does no funding
    "AGENT_EVIDENCE_URL": "",
    // the cron's auto-funding of the agent's registrations (POST /fund-agent): at most this much NEAR per rolling
    // 24 hours in all, as the relayer reports it sent; each call reserves 0.16 NEAR (its most) before it is made.
    // "0" turns the funding off. The relayer's own 0.5 NEAR per implicit account per 24 hours stays the inner bound
    "FUND_NEAR_PER_DAY": "2"
  },
  "containers": [
    {
      "class_name": "CmdkBackend",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "CmdkBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CmdkBackend"] }]
}
